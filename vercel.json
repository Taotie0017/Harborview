{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/index"
    },
    {
      "source": "/admin",
      "destination": "/api/index?__path=/admin"
    },
    {
      "source": "/admin/:path*",
      "destination": "/api/index?__path=/admin/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/api/$1"
    }
  ]
}

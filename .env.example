# Copy this file to .env and change the secret before you run the site.
# .env is ignored by Git. Do not commit real passwords or secret keys.

SECRET_KEY=replace-this-with-a-long-random-string
FLASK_DEBUG=1
PORT=5000

# Supabase project settings. Use the service-role key only on the server.
DATABASE_BACKEND=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Local SQLite is available for tests/offline development:
# DATABASE_BACKEND=sqlite
# DATABASE_PATH=instance/student_events.db

# Optional. create_admin.py reads these if you do not want to type them.
# ADMIN_NAME=Event Office
# ADMIN_EMAIL=admin@university.edu
# ADMIN_PASSWORD=ChangeMe123!
